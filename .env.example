# Environment variables for E2E testing
# Copy this to .env.test and fill in your test values

# AWS Cognito Configuration for Testing
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Test Environment URLs
VITE_API_BASE_URL=https://your-test-api-gateway.execute-api.us-east-1.amazonaws.com/test

# AWS Credentials for test user management (use IAM user with minimal permissions)
AWS_ACCESS_KEY_ID=your-test-access-key
AWS_SECRET_ACCESS_KEY=your-test-secret-key

# Test Configuration
NODE_ENV=test
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSERS=chromium,firefox,webkit

# CI/CD Configuration
CI=false
AMPLIFY_APP_ID=your-amplify-app-id