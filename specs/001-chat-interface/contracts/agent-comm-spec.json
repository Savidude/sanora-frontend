{
   "openapi":"3.1.0",
   "info":{
      "title":"Messaging API",
      "description":"API endpoint invoking AWS Agentcore messaging services.",
      "version":"0.1.0"
   },
   "paths":{
      "/api/v1/chat/message":{
         "post":{
            "tags":[
               "v1",
               "chat"
            ],
            "summary":"Create Chat",
            "description":"Send a message to the tutor agent\n\nArgs:\n    request: The prompt request containing message and session ID\n    service: The agent communication service dependency\n\nReturns:\n    AgentResponse: The response from the tutor agent\n\nRaises:\n    HTTPException: If there is an error invoking the agent or processing the response",
            "operationId":"create_chat_api_v1_chat_message_post",
            "requestBody":{
               "content":{
                  "application/json":{
                     "schema":{
                        "$ref":"#/components/schemas/PromptRequest"
                     }
                  }
               },
               "required":true
            },
            "responses":{
               "200":{
                  "description":"Successful Response",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/AgentResponse"
                        }
                     }
                  }
               },
               "422":{
                  "description":"Validation Error",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/HTTPValidationError"
                        }
                     }
                  }
               }
            }
         }
      },
      "/health":{
         "get":{
            "summary":"Health Check",
            "description":"Health check endpoint",
            "operationId":"health_check_health_get",
            "responses":{
               "200":{
                  "description":"Successful Response",
                  "content":{
                     "application/json":{
                        "schema":{
                           
                        }
                     }
                  }
               }
            }
         }
      }
   },
   "components":{
      "schemas":{
         "AgentResponse":{
            "properties":{
               "success":{
                  "type":"boolean",
                  "title":"Success",
                  "default":true
               },
               "data":{
                  "$ref":"#/components/schemas/TutorResponseData"
               },
               "session_id":{
                  "type":"string",
                  "title":"Session Id"
               },
               "timestamp":{
                  "type":"string",
                  "format":"date-time",
                  "title":"Timestamp"
               }
            },
            "type":"object",
            "required":[
               "data",
               "session_id",
               "timestamp"
            ],
            "title":"AgentResponse",
            "description":"Response model for Agentcore invokation\n\nAttributes:\n    success: Indicates if the invocation was successful\n    data: The response data specific to the agent type\n    session_id: The session ID used for the invocation\n    timestamp: The timestamp of the response"
         },
         "ErrorDetail":{
            "properties":{
               "user_mistake":{
                  "anyOf":[
                     {
                        "type":"string"
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"User Mistake"
               },
               "corrections":{
                  "items":{
                     "type":"string"
                  },
                  "type":"array",
                  "title":"Corrections",
                  "default":[
                     
                  ]
               },
               "explanation":{
                  "anyOf":[
                     {
                        "type":"string"
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Explanation"
               }
            },
            "type":"object",
            "title":"ErrorDetail",
            "description":"Details about user mistakes and corrections\n\nAtributes:\n    user_mistake: The specific mistake made by the user\n    corrections: List of suggested corrections for the mistake\n    explanation: Explanation of the mistake and corrections"
         },
         "ErrorType":{
            "type":"string",
            "enum":[
               "YES",
               "NO",
               "MINOR"
            ],
            "title":"ErrorType",
            "description":"Error types for categorizing errors in communication\n\nAttributes:\n    YES: Significant errors affecting understanding\n    NO: No errors present\n    MINOR: Minor errors not significantly affecting understanding"
         },
         "HTTPValidationError":{
            "properties":{
               "detail":{
                  "items":{
                     "$ref":"#/components/schemas/ValidationError"
                  },
                  "type":"array",
                  "title":"Detail"
               }
            },
            "type":"object",
            "title":"HTTPValidationError"
         },
         "MessageType":{
            "type":"string",
            "enum":[
               "initiation",
               "feedback",
               "conclusion"
            ],
            "title":"MessageType",
            "description":"Message types for categorizing communication\n\nAttributes:\n    INITIATION: Initial messages to start a conversation\n    FEEDBACK: Messages providing feedback during the conversation\n    CONCLUSION: Closing messages to end the conversation"
         },
         "PromptRequest":{
            "properties":{
               "message":{
                  "type":"string",
                  "title":"Message"
               },
               "sessionId":{
                  "type":"string",
                  "title":"Sessionid"
               }
            },
            "type":"object",
            "required":[
               "message",
               "sessionId"
            ],
            "title":"PromptRequest",
            "description":"Required data for Agentcore invokation\n\nAttributes:\n    message: The prompt message to send to the agent\n    sessionId: The unique session identifier for tracking the conversation"
         },
         "TutorResponseData":{
            "properties":{
               "message_type":{
                  "$ref":"#/components/schemas/MessageType"
               },
               "has_error":{
                  "$ref":"#/components/schemas/ErrorType"
               },
               "feedback_text":{
                  "anyOf":[
                     {
                        "type":"string"
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Feedback Text"
               },
               "error_details":{
                  "anyOf":[
                     {
                        "$ref":"#/components/schemas/ErrorDetail"
                     },
                     {
                        "type":"null"
                     }
                  ]
               },
               "greeting":{
                  "anyOf":[
                     {
                        "type":"string"
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Greeting"
               },
               "scenario":{
                  "anyOf":[
                     {
                        "type":"string"
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Scenario"
               },
               "conversation_continuation":{
                  "type":"string",
                  "title":"Conversation Continuation"
               },
               "word_tips":{
                  "items":{
                     "$ref":"#/components/schemas/WordTip"
                  },
                  "type":"array",
                  "title":"Word Tips"
               }
            },
            "type":"object",
            "required":[
               "message_type",
               "has_error",
               "conversation_continuation",
               "word_tips"
            ],
            "title":"TutorResponseData",
            "description":"Data returned from the invokation of the tutor agent\n\nAttributes:\n    message_type: The type of message (initiation, feedback, conclusion)\n    has_error: Indicates if there was an error in the user's response\n    feedback_text: Feedback provided by the tutor agent\n    error_details: Details about any mistakes made by the user\n    greeting: Optional greeting message from the tutor agent\n    scenario: Optional scenario description for context\n    conversation_continuation: Text to continue the conversation\n    word_tips: List of tips for difficult words encountered"
         },
         "ValidationError":{
            "properties":{
               "loc":{
                  "items":{
                     "anyOf":[
                        {
                           "type":"string"
                        },
                        {
                           "type":"integer"
                        }
                     ]
                  },
                  "type":"array",
                  "title":"Location"
               },
               "msg":{
                  "type":"string",
                  "title":"Message"
               },
               "type":{
                  "type":"string",
                  "title":"Error Type"
               }
            },
            "type":"object",
            "required":[
               "loc",
               "msg",
               "type"
            ],
            "title":"ValidationError"
         },
         "WordTip":{
            "properties":{
               "finnish":{
                  "type":"string",
                  "title":"Finnish"
               },
               "english":{
                  "type":"string",
                  "title":"English"
               }
            },
            "type":"object",
            "required":[
               "finnish",
               "english"
            ],
            "title":"WordTip",
            "description":"Tips for difficult words in the communication\n\nAttributes:\n    finnish: The difficult word in Finnish\n    english: The English translation of the difficult word"
         }
      }
   }
}